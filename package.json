{
  "name": "pinterest-api",
  "version": "1.0.0",
  "description": "Self-hosted Pinterest image search REST API",
  "keywords": [
    "pinterest",
    "search",
    "api",
    "images",
    "rest",
    "hono",
    "self-hosted"
  ],
  "homepage": "https://github.com/mxhiraz/pin-scrp#readme",
  "bugs": {
    "url": "https://github.com/mxhiraz/pin-scrp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mxhiraz/pin-scrp.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/api.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14"
  },
  "optionalDependencies": {
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.7"
  }
}
