            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('error body', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.code).to.eql(400);",
              "  pm.expect(json.error).to.include('q');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/search",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "search"
          ]
        },
        "description": "Expect { \"error\": \"Missing required query param: q\", \"code\": 400 }."
      },
      "response": []
    },
    {
      "name": "Error - empty q after sanitizing (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('error mentions sanitization', () => pm.expect(pm.response.json().error).to.include('sanitization'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/search?q=%20%20%20",
          "host": [
