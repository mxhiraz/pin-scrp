{
  "info": {
    "name": "Pinterest API",
    "description": "Pinterest image search API (https://github.com/mxhiraz/pin-scrp).\n\nPick the \"Pinterest API - local\" environment, set baseUrl if you moved off 7777, and set apiKey to whatever API_KEY is in the server's .env.\n\n/health takes no key. /search wants it in the x-api-key header, and takes q (required, cut to 200 chars), count (1..50, default 25), bookmark (cursor from an earlier response), fresh=1 to skip the cache, and skip_pages=N to walk N Pinterest pages first (0..20).\n\nResponses carry X-Cache (HIT, MISS, or BYPASS) and X-Request-ID. A 429 also carries Retry-After. Errors come back as { error, code }: 400 for a missing or empty q, 401 for a bad key, 404 for an unknown path, 429 when rate limited, 500 when the server has no API_KEY, 502 when Pinterest itself failed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "b5f2c0a4-1f8e-4d2a-9d5e-pin-scrp-0001"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7777",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "change-me",
      "type": "string"
    },
    {
      "key": "bookmark",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "x-api-key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('status is ok', () => pm.expect(json.status).to.eql('ok'));",
              "pm.test('uptime is a number', () => pm.expect(json.uptime).to.be.a('number'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "No key needed. uptime is in seconds."
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"status\": \"ok\",\n  \"uptime\": 5\n}"
        }
      ]
    },
    {
      "name": "Search - basic",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('has pins array', () => pm.expect(json.pins).to.be.an('array'));",
              "pm.test('count matches pins length', () => pm.expect(json.count).to.eql(json.pins.length));",
              "pm.test('X-Cache header present', () => pm.expect(pm.response.headers.get('X-Cache')).to.be.oneOf(['HIT', 'MISS']));",
              "pm.test('X-Request-ID header present', () => pm.expect(pm.response.headers.get('X-Request-ID')).to.be.a('string'));",
              "if (json.pins.length) {",
              "  const pin = json.pins[0];",
              "  pm.test('pin has id and pinterest_url', () => {",
              "    pm.expect(pin.id).to.be.a('string').and.not.empty;",
              "    pm.expect(pin.pinterest_url).to.include('pinterest.com/pin/');",
              "  });",
              "}",
              "if (json.bookmark) {",
              "  pm.collectionVariables.set('bookmark', json.bookmark);",
              "  console.log('Saved bookmark:', json.bookmark);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/search?q=fashion editorial&count=25",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "search"
          ],
          "query": [
            {
              "key": "q",
              "value": "fashion editorial"
            },
            {
              "key": "count",
              "value": "25"
            }
          ]
        },
        "description": "Page one. The test script stashes the bookmark for the paging request below."
      },
      "response": [
        {
          "name": "200 OK (trimmed)",
          "originalRequest": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/search?q=fashion editorial&count=25",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "fashion editorial"
                },
                {
                  "key": "count",
                  "value": "25"
                }
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "X-Cache",
              "value": "MISS"
            },
            {
              "key": "X-Request-ID",
              "value": "ec19ccee-f4ed-4661-8483-f88278fed767"
            }
          ],
          "body": "{\n  \"query\": \"fashion editorial\",\n  \"count\": 1,\n  \"bookmark\": \"Y2JVSG81V2sxcmNHRlpWM1J5VFVad1YxcEhSbE5X...\",\n  \"pins\": [\n    {\n      \"id\": \"36239971996748877\",\n      \"title\": \"Minimal Tie Accessories That Make Tailoring Feel Editorial\",\n      \"description\": \"Minimal tie accessories bring a cinematic editorial mood...\",\n      \"link\": null,\n      \"pinterest_url\": \"https://www.pinterest.com/pin/36239971996748877\",\n      \"images\": {\n        \"170x\": { \"url\": \"https://i.pinimg.com/236x/47/e2/a0/47e2a0.jpg\", \"width\": 236, \"height\": 354 },\n        \"236x\": { \"url\": \"https://i.pinimg.com/236x/47/e2/a0/47e2a0.jpg\", \"width\": 236, \"height\": 354 },\n        \"474x\": { \"url\": \"https://i.pinimg.com/474x/47/e2/a0/47e2a0.jpg\", \"width\": 474, \"height\": 711 },\n        \"736x\": { \"url\": \"https://i.pinimg.com/736x/47/e2/a0/47e2a0.jpg\", \"width\": 736, \"height\": 1104 },\n        \"orig\": { \"url\": \"https://i.pinimg.com/originals/47/e2/a0/47e2a0.webp\", \"width\": 1024, \"height\": 1536 }\n      },\n      \"dominant_color\": \"#ccc1b2\",\n      \"saves\": 0,\n      \"created_at\": \"Thu, 09 Jul 2026 14:43:57 +0000\",\n      \"board\": { \"id\": \"36240040690912166\", \"name\": \"Editorial\" },\n      \"creator\": {\n        \"username\": \"kanyarat5554\",\n        \"display_name\": \"Kanyarat\",\n        \"avatar_url\": \"https://s.pinimg.com/images/user/default_75.png\"\n      }\n    }\n  ]\n}"
        }
      ]
    },
    {
      "name": "Search - cached repeat (X-Cache: HIT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('served from cache', () => pm.expect(pm.response.headers.get('X-Cache')).to.eql('HIT'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/search?q=fashion editorial&count=25",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "search"
          ],
          "query": [
            {
              "key": "q",
              "value": "fashion editorial"
            },
            {
              "key": "count",
              "value": "25"
            }
          ]
        },
        "description": "Same query and count as Search - basic, so it should come from the cache. Won't if CACHE_TTL_SECONDS is 0 or the TTL ran out."
      },
      "response": []
    },
    {
      "name": "Search - paginated (uses saved bookmark)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('has pins array', () => pm.expect(json.pins).to.be.an('array'));",
              "if (json.bookmark) pm.collectionVariables.set('bookmark', json.bookmark);",
              "else console.log('End of results, bookmark is null.');"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/search?q=fashion editorial&count=25&bookmark={{bookmark}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "search"
          ],
          "query": [
            {
              "key": "q",
              "value": "fashion editorial"
            },
            {
              "key": "count",
              "value": "25"
            },
            {
              "key": "bookmark",
              "value": "{{bookmark}}"
            }
          ]
        },
        "description": "Run Search - basic first so {{bookmark}} has a value. Every run saves the next cursor, so keep hitting send until the bookmark comes back null."
      },
      "response": []
    },
    {
      "name": "Search - max count",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('never returns more than 50', () => pm.expect(pm.response.json().pins.length).to.be.at.most(50));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/search?q=minimalist interior&count=99",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "search"
          ],
          "query": [
            {
              "key": "q",
              "value": "minimalist interior"
            },
            {
              "key": "count",
              "value": "99"
            }
          ]
        },
        "description": "count is clamped to 1..50, so 99 acts as 50."
      },
      "response": []
    },
    {
      "name": "Search - fresh (bypass cache)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('cache bypassed', () => pm.expect(pm.response.headers.get('X-Cache')).to.eql('BYPASS'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/search?q=fashion editorial&count=10&fresh=1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "search"
          ],
          "query": [
            {
              "key": "q",
              "value": "fashion editorial"
            },
            {
              "key": "count",
              "value": "10"
            },
            {
              "key": "fresh",
              "value": "1"
            }
          ]
        },
        "description": "Skips the cache both ways. Look for X-Cache: BYPASS. Also accepts true or yes."
      },
      "response": []
    },
    {
      "name": "Search - skip_pages (deeper pins)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('cache bypassed', () => pm.expect(pm.response.headers.get('X-Cache')).to.eql('BYPASS'));",
              "console.log('pin ids:', pm.response.json().pins.map(p => p.id).join(','));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/search?q=fashion editorial&count=10&skip_pages=3",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "search"
          ],
          "query": [
            {
              "key": "q",
              "value": "fashion editorial"
            },
            {
              "key": "count",
              "value": "10"
            },
            {
              "key": "skip_pages",
              "value": "3"
            }
          ]
        },
        "description": "Walks N Pinterest pages and gives you the next one, 0..20, never cached. Every page is one more request to Pinterest."
      },
      "response": []
    },
    {
      "name": "Custom X-Request-ID (log correlation)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('request id echoed back', () => pm.expect(pm.response.headers.get('X-Request-ID')).to.eql('postman-demo-1'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Request-ID",
            "value": "postman-demo-1"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/search?q=fashion editorial&count=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "search"
          ],
          "query": [
            {
              "key": "q",
              "value": "fashion editorial"
            },
            {
              "key": "count",
              "value": "5"
            }
          ]
        },
        "description": "Send your own id and the server keeps it in the response and the logs. Leave it off and it makes a UUID."
      },
      "response": []
    },
    {
      "name": "Error - missing q (400)",
      "event": [
        {
          "listen": "test",
          "script": {
