          ],
          "query": [
            {
              "key": "q",
              "value": "%20%20%20"
            }
          ]
        },
        "description": "Spaces and control characters alone don't count as a query: { \"error\": \"Empty query after sanitization\", \"code\": 400 }."
      },
      "response": []
    },
