{
  "info": {
    "name": "Pinterest API",
    "description": "Self-hosted Pinterest image search API (https://github.com/mxhiraz/pin-scrp).\n\nSet `baseUrl` and `apiKey` in the **Pinterest API - local** environment before running. `apiKey` must match `API_KEY` in the server's `.env`.\n\n**Endpoints**\n- `GET /health` — no auth, returns `{ status, uptime }`.\n- `GET /search` — requires the `x-api-key` header.\n\n**Query params on /search**\n- `q` (required) — search text. Control characters stripped, trimmed, cut to 200 chars.\n- `count` — 1..50, default 25.\n- `bookmark` — pagination cursor from a previous response. `null` in a response means the end.\n- `fresh=1` — bypass the cache read.\n- `skip_pages=N` — walk N upstream Pinterest pages before returning (0..20). Different N returns different real pins.\n\n**Response headers**\n- `X-Cache` — `HIT`, `MISS`, or `BYPASS` (when `fresh` or `skip_pages` is used).\n- `X-Request-ID` — echoed from the request if sent, otherwise generated. Shows up in server logs.\n- `Retry-After` — seconds to wait, sent with `429` only.\n\n**Error codes:** 400 missing/empty `q`, 401 bad key, 404 unknown path, 429 rate limited, 500 server missing `API_KEY`, 502 Pinterest failed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "b5f2c0a4-1f8e-4d2a-9d5e-pin-scrp-0001"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:9000", "type": "string" },
    { "key": "apiKey", "value": "change-me", "type": "string" },
    { "key": "bookmark", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "x-api-key", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('status is ok', () => pm.expect(json.status).to.eql('ok'));",
              "pm.test('uptime is a number', () => pm.expect(json.uptime).to.be.a('number'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "auth": { "type": "noauth" },
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Liveness probe. No auth required. `uptime` is in seconds."
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"status\": \"ok\",\n  \"uptime\": 5\n}"
        }
      ]
    },
    {
      "name": "Search - basic",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('has pins array', () => pm.expect(json.pins).to.be.an('array'));",
              "pm.test('count matches pins length', () => pm.expect(json.count).to.eql(json.pins.length));",
              "pm.test('X-Cache header present', () => pm.expect(pm.response.headers.get('X-Cache')).to.be.oneOf(['HIT', 'MISS']));",
              "pm.test('X-Request-ID header present', () => pm.expect(pm.response.headers.get('X-Request-ID')).to.be.a('string'));",
              "if (json.pins.length) {",
              "  const pin = json.pins[0];",
              "  pm.test('pin has id and pinterest_url', () => {",
              "    pm.expect(pin.id).to.be.a('string').and.not.empty;",
              "    pm.expect(pin.pinterest_url).to.include('pinterest.com/pin/');",
              "  });",
              "}",
              "if (json.bookmark) {",
              "  pm.collectionVariables.set('bookmark', json.bookmark);",
              "  console.log('Saved bookmark:', json.bookmark);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/search?q=fashion editorial&count=25",
          "host": ["{{baseUrl}}"],
          "path": ["search"],
          "query": [
            { "key": "q", "value": "fashion editorial" },
            { "key": "count", "value": "25" }
          ]
        },
        "description": "First page. The test script auto-saves the `bookmark` collection variable for the pagination request below."
      },
      "response": [
        {
          "name": "200 OK (trimmed)",
          "originalRequest": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/search?q=fashion editorial&count=25",
              "host": ["{{baseUrl}}"],
              "path": ["search"],
              "query": [
                { "key": "q", "value": "fashion editorial" },
                { "key": "count", "value": "25" }
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "header": [
            { "key": "Content-Type", "value": "application/json" },
            { "key": "X-Cache", "value": "MISS" },
            { "key": "X-Request-ID", "value": "ec19ccee-f4ed-4661-8483-f88278fed767" }
          ],
          "body": "{\n  \"query\": \"fashion editorial\",\n  \"count\": 1,\n  \"bookmark\": \"Y2JVSG81V2sxcmNHRlpWM1J5VFVad1YxcEhSbE5X...\",\n  \"pins\": [\n    {\n      \"id\": \"36239971996748877\",\n      \"title\": \"Minimal Tie Accessories That Make Tailoring Feel Editorial\",\n      \"description\": \"Minimal tie accessories bring a cinematic editorial mood...\",\n      \"link\": null,\n      \"pinterest_url\": \"https://www.pinterest.com/pin/36239971996748877\",\n      \"images\": {\n        \"170x\": { \"url\": \"https://i.pinimg.com/236x/47/e2/a0/47e2a0.jpg\", \"width\": 236, \"height\": 354 },\n        \"236x\": { \"url\": \"https://i.pinimg.com/236x/47/e2/a0/47e2a0.jpg\", \"width\": 236, \"height\": 354 },\n        \"474x\": { \"url\": \"https://i.pinimg.com/474x/47/e2/a0/47e2a0.jpg\", \"width\": 474, \"height\": 711 },\n        \"736x\": { \"url\": \"https://i.pinimg.com/736x/47/e2/a0/47e2a0.jpg\", \"width\": 736, \"height\": 1104 },\n        \"orig\": { \"url\": \"https://i.pinimg.com/originals/47/e2/a0/47e2a0.webp\", \"width\": 1024, \"height\": 1536 }\n      },\n      \"dominant_color\": \"#ccc1b2\",\n      \"saves\": 0,\n      \"created_at\": \"Thu, 09 Jul 2026 14:43:57 +0000\",\n      \"board\": { \"id\": \"36240040690912166\", \"name\": \"Editorial\" },\n      \"creator\": {\n        \"username\": \"kanyarat5554\",\n        \"display_name\": \"Kanyarat\",\n        \"avatar_url\": \"https://s.pinimg.com/images/user/default_75.png\"\n      }\n    }\n  ]\n}"
        }
      ]
    },
    {
      "name": "Search - cached repeat (X-Cache: HIT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('served from cache', () => pm.expect(pm.response.headers.get('X-Cache')).to.eql('HIT'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/search?q=fashion editorial&count=25",
          "host": ["{{baseUrl}}"],
          "path": ["search"],
          "query": [
            { "key": "q", "value": "fashion editorial" },
            { "key": "count", "value": "25" }
          ]
        },
        "description": "Same query and count as **Search - basic**, so it hits the cache. Fails if `CACHE_TTL_SECONDS=0` or the TTL has already expired."
      },
      "response": []
    },
    {
      "name": "Search - paginated (uses saved bookmark)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('has pins array', () => pm.expect(json.pins).to.be.an('array'));",
              "if (json.bookmark) pm.collectionVariables.set('bookmark', json.bookmark);",
              "else console.log('End of results — bookmark is null.');"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/search?q=fashion editorial&count=25&bookmark={{bookmark}}",
          "host": ["{{baseUrl}}"],
          "path": ["search"],
          "query": [
            { "key": "q", "value": "fashion editorial" },
            { "key": "count", "value": "25" },
            { "key": "bookmark", "value": "{{bookmark}}" }
          ]
        },
        "description": "Run **Search - basic** first to populate `{{bookmark}}`. Each run saves the next cursor, so it is re-runnable until the response bookmark is `null`."
      },
      "response": []
    },
    {
      "name": "Search - max count",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('never returns more than 50', () => pm.expect(pm.response.json().pins.length).to.be.at.most(50));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/search?q=minimalist interior&count=99",
          "host": ["{{baseUrl}}"],
          "path": ["search"],
          "query": [
            { "key": "q", "value": "minimalist interior" },
            { "key": "count", "value": "99" }
          ]
        },
        "description": "`count` is clamped to 1..50, so 99 behaves as 50."
      },
      "response": []
    },
    {
      "name": "Search - fresh (bypass cache)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('cache bypassed', () => pm.expect(pm.response.headers.get('X-Cache')).to.eql('BYPASS'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/search?q=fashion editorial&count=10&fresh=1",
          "host": ["{{baseUrl}}"],
          "path": ["search"],
          "query": [
            { "key": "q", "value": "fashion editorial" },
            { "key": "count", "value": "10" },
            { "key": "fresh", "value": "1" }
          ]
        },
        "description": "Skips the cache read and the cache write. Response header `X-Cache: BYPASS`. Accepts `1`, `true`, or `yes`."
      },
      "response": []
    },
    {
      "name": "Search - skip_pages (deeper pins)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('cache bypassed', () => pm.expect(pm.response.headers.get('X-Cache')).to.eql('BYPASS'));",
              "console.log('pin ids:', pm.response.json().pins.map(p => p.id).join(','));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/search?q=fashion editorial&count=10&skip_pages=3",
          "host": ["{{baseUrl}}"],
          "path": ["search"],
          "query": [
            { "key": "q", "value": "fashion editorial" },
            { "key": "count", "value": "10" },
            { "key": "skip_pages", "value": "3" }
          ]
        },
        "description": "The server walks N upstream Pinterest pages and returns the next one. Clamped to 0..20 and never cached. Vary N (1, 2, 3, ...) to get different real pins — each page costs one extra upstream request, so it is slower."
      },
      "response": []
    },
    {
      "name": "Custom X-Request-ID (log correlation)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('request id echoed back', () => pm.expect(pm.response.headers.get('X-Request-ID')).to.eql('postman-demo-1'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Request-ID", "value": "postman-demo-1" }],
        "url": {
          "raw": "{{baseUrl}}/search?q=fashion editorial&count=5",
          "host": ["{{baseUrl}}"],
          "path": ["search"],
          "query": [
            { "key": "q", "value": "fashion editorial" },
            { "key": "count", "value": "5" }
          ]
        },
        "description": "Send your own `X-Request-ID` and the server reuses it in the response and in its logs. Omit it and the server generates a UUID."
      },
      "response": []
    },
    {
      "name": "Error - missing q (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('error body', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.code).to.eql(400);",
              "  pm.expect(json.error).to.include('q');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/search",
          "host": ["{{baseUrl}}"],
          "path": ["search"]
        },
        "description": "Expect `{ \"error\": \"Missing required query param: q\", \"code\": 400 }`."
      },
      "response": []
    },
    {
      "name": "Error - empty q after sanitizing (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('error mentions sanitization', () => pm.expect(pm.response.json().error).to.include('sanitization'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/search?q=%20%20%20",
          "host": ["{{baseUrl}}"],
          "path": ["search"],
          "query": [{ "key": "q", "value": "%20%20%20" }]
        },
        "description": "Whitespace-only or control-character-only queries are rejected: `{ \"error\": \"Empty query after sanitization\", \"code\": 400 }`."
      },
      "response": []
    },
    {
      "name": "Error - bad api key (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
              "pm.test('error body', () => pm.expect(pm.response.json()).to.eql({ error: 'Unauthorized', code: 401 }));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "auth": {
          "type": "apikey",
          "apikey": [
            { "key": "key", "value": "x-api-key", "type": "string" },
            { "key": "value", "value": "wrong-key", "type": "string" },
            { "key": "in", "value": "header", "type": "string" }
          ]
        },
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/search?q=test",
          "host": ["{{baseUrl}}"],
          "path": ["search"],
          "query": [{ "key": "q", "value": "test" }]
        },
        "description": "A missing or wrong `x-api-key` returns `401 Unauthorized`."
      },
      "response": []
    },
    {
      "name": "Error - unknown path (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
              "pm.test('error body', () => pm.expect(pm.response.json()).to.eql({ error: 'Not found', code: 404 }));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/does-not-exist",
          "host": ["{{baseUrl}}"],
          "path": ["does-not-exist"]
        },
        "description": "Only `/health` and `/search` exist."
      },
      "response": []
    },
    {
      "name": "Error - rate limit (429)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Fire enough requests to drain the bucket, then assert the 429 shape.",
              "// Set RATE_LIMIT_RPM low (e.g. 3) on the server to see this quickly.",
              "if (pm.response.code === 429) {",
              "  pm.test('has Retry-After', () => pm.expect(pm.response.headers.get('Retry-After')).to.be.a('string'));",
              "  pm.test('error body', () => pm.expect(pm.response.json()).to.eql({ error: 'Rate limit exceeded', code: 429 }));",
              "} else {",
              "  pm.test('not rate limited yet — rerun until 429', () => pm.expect(pm.response.code).to.eql(200));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/search?q=rate limit probe&fresh=1",
          "host": ["{{baseUrl}}"],
          "path": ["search"],
          "query": [
            { "key": "q", "value": "rate limit probe" },
            { "key": "fresh", "value": "1" }
          ]
        },
        "description": "Per-IP token bucket, `RATE_LIMIT_RPM` requests per minute (default 60). Send it repeatedly until you get `429` plus a `Retry-After` header in seconds. Start the server with `RATE_LIMIT_RPM=3` to trip it in a few clicks."
      },
      "response": [
        {
          "name": "429 Too Many Requests",
          "originalRequest": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/search?q=rate limit probe&fresh=1",
              "host": ["{{baseUrl}}"],
              "path": ["search"],
              "query": [
                { "key": "q", "value": "rate limit probe" },
                { "key": "fresh", "value": "1" }
              ]
            }
          },
          "status": "Too Many Requests",
          "code": 429,
          "header": [
            { "key": "Content-Type", "value": "application/json" },
            { "key": "Retry-After", "value": "2" }
          ],
          "body": "{\n  \"error\": \"Rate limit exceeded\",\n  \"code\": 429\n}"
        }
      ]
    }
  ]
}
