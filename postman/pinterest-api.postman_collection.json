              "type": "string"
            }
          ]
        },
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/search?q=test",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "search"
          ],
          "query": [
            {
              "key": "q",
              "value": "test"
            }
          ]
        },
        "description": "Wrong or missing x-api-key gives 401."
      },
      "response": []
    },
    {
      "name": "Error - unknown path (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
              "pm.test('error body', () => pm.expect(pm.response.json()).to.eql({ error: 'Not found', code: 404 }));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/does-not-exist",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "does-not-exist"
          ]
        },
        "description": "Only /health and /search exist."
      },
      "response": []
    },
    {
      "name": "Error - rate limit (429)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Drain the bucket, then assert the 429 shape.",
              "// Set RATE_LIMIT_RPM=3 on the server to reach it sooner.",
              "if (pm.response.code === 429) {",
              "  pm.test('has Retry-After', () => pm.expect(pm.response.headers.get('Retry-After')).to.be.a('string'));",
              "  pm.test('error body', () => pm.expect(pm.response.json()).to.eql({ error: 'Rate limit exceeded', code: 429 }));",
              "} else {",
              "  pm.test('not rate limited yet, rerun until 429', () => pm.expect(pm.response.code).to.eql(200));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/search?q=rate limit probe&fresh=1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "search"
          ],
          "query": [
            {
              "key": "q",
              "value": "rate limit probe"
            },
            {
              "key": "fresh",
              "value": "1"
            }
          ]
        },
        "description": "Token bucket per IP, RATE_LIMIT_RPM a minute (60 by default). Keep sending until it gives 429 plus Retry-After in seconds. Start the server with RATE_LIMIT_RPM=3 if you don't want to click 60 times."
      },
      "response": [
        {
          "name": "429 Too Many Requests",
          "originalRequest": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/search?q=rate limit probe&fresh=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "rate limit probe"
                },
                {
                  "key": "fresh",
                  "value": "1"
                }
              ]
            }
          },
          "status": "Too Many Requests",
          "code": 429,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Retry-After",
              "value": "2"
            }
          ],
          "body": "{\n  \"error\": \"Rate limit exceeded\",\n  \"code\": 429\n}"
        }
      ]
    }
  ]
