            "exec": [
              "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
              "pm.test('error body', () => pm.expect(pm.response.json()).to.eql({ error: 'Unauthorized', code: 401 }));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "auth": {
          "type": "apikey",
          "apikey": [
            {
              "key": "key",
